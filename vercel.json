{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/blog/fatigue-creative-facebook-ads(\\.html)?", "status": 301, "headers": { "Location": "/blog" } },
    { "src": "/demo/(.*)", "dest": "https://adstack-server.onrender.com/demo/$1" },
    { "src": "/s/(.*)", "dest": "https://adstack-server.onrender.com/s/$1" },
    { "src": "/adboard/(.*)", "dest": "/adboard.html" },
    { "src": "/adboard", "dest": "/adboard.html" },
    { "src": "/factory-next/(.*)", "dest": "/factory-next.html" },
    { "src": "/factory-next", "dest": "/factory-next.html" },
    { "src": "/factory/(.*)", "dest": "/factory-next.html" },
    { "src": "/factory", "dest": "/factory-next.html" },
    { "src": "/factory-ancien", "dest": "/factory.html" },
    { "src": "/adstats/(.*)", "dest": "/adstats.html" },
    { "src": "/adstats", "dest": "/adstats.html" },
    { "src": "/vente", "status": 307, "headers": { "Location": "/pdv" } },
    { "src": "/pdv", "dest": "/vente.html" },
    { "src": "/blog", "dest": "/blog/index.html" },
    { "src": "/blog/", "dest": "/blog/index.html" },
    { "src": "/blog/([^/.]+)", "dest": "/blog/$1.html" },
    { "src": "/etude-de-cas/(.*)", "dest": "/etude-de-cas.html" },
    { "src": "/etude-de-cas", "dest": "/etude-de-cas.html" },
    { "src": "/quiz", "dest": "/quiz.html" },
    { "src": "/quiz-resultat", "dest": "/quiz-resultat.html" },
    { "src": "/", "dest": "/vente.html" }
  ]
}
